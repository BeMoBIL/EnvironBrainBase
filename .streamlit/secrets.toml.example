# Copy this file to `.streamlit/secrets.toml` (NOT committed) for local
# development. On Streamlit Community Cloud, paste the same TOML into
# Settings → Secrets.

[github]
# Fine-grained PAT scoped to ONLY this repo, with permissions:
#   Contents: Read & write
#   Pull requests: Read & write
# Generate at https://github.com/settings/personal-access-tokens/new
token       = "github_pat_REPLACE_ME"

repo        = "Randomidous/NeuroUrbanism-DB"
base_branch = "main"
